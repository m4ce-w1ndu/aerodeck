// AeroDeck design tokens: a glass-cockpit palette (cyan / green / amber / red, as on a PFD)
// over deep navy surfaces, with a light variant.

export global Theme {
    in-out property <bool> dark: true;

    // Surfaces, from the window background up to raised controls
    out property <color> bg: dark ? #070b12 : #eef2f7;
    out property <color> bg-glow: dark ? #0f2a3d : #dbeafe;
    out property <color> sidebar: dark ? #0a1019 : #f8fafc;
    out property <color> surface: dark ? #0f1620 : #ffffff;
    out property <color> surface-2: dark ? #141d29 : #f6f8fb;
    out property <color> surface-3: dark ? #1b2635 : #edf1f6;
    out property <color> hover: dark ? #ffffff0d : #0f172a0a;
    out property <color> border: dark ? #1f2b3a : #dfe5ec;
    out property <color> border-strong: dark ? #2c3c50 : #c9d3de;

    // Text
    out property <color> text: dark ? #e7eef7 : #0d1724;
    out property <color> text-2: dark ? #9aabbf : #475569;
    out property <color> text-3: dark ? #5f7189 : #8a97a8;
    out property <color> on-accent: dark ? #04141c : #ffffff;

    // Signal colours
    out property <color> accent: dark ? #2fd5f4 : #0891b2;
    out property <color> accent-2: dark ? #38bdf8 : #0284c7;
    out property <color> violet: dark ? #a78bfa : #7c3aed;
    out property <color> success: dark ? #34d399 : #059669;
    out property <color> warning: dark ? #fbbf24 : #d97706;
    out property <color> danger: dark ? #f87171 : #dc2626;

    out property <brush> accent-gradient: @linear-gradient(135deg, accent 0%, accent-2 100%);

    // Shape
    out property <length> radius-s: 6px;
    out property <length> radius-m: 9px;
    out property <length> radius-l: 14px;

    // Type
    out property <string> font: "Inter";
    out property <string> mono: "JetBrains Mono";
    out property <length> fs-xs: 11px;
    out property <length> fs-s: 12px;
    out property <length> fs-m: 13px;
    out property <length> fs-l: 15px;
    out property <length> fs-xl: 19px;
    out property <length> fs-xxl: 26px;

    // Colour for a tone index: 0 neutral, 1 accent, 2 success, 3 warning, 4 danger, 5 violet
    public pure function tone(t: int) -> color {
        if t == 1 { return accent; }
        if t == 2 { return success; }
        if t == 3 { return warning; }
        if t == 4 { return danger; }
        if t == 5 { return violet; }
        return text-2;
    }
}

