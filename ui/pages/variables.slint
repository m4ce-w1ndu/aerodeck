import { ScrollView, ListView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import {
    Button, ButtonKind, IconButton, Card, Panel, SectionTitle, Pill, Dot, Ico, IconTile, EmptyState, Mono, Hint,
    Label, Caption, Field, Divider
} from "../components/base.slint";
import { VarsState, VarRow } from "../state.slint";

component ValueTable inherits Card {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    in property <color> tone: Theme.accent;
    in property <[VarRow]> rows;
    in property <string> empty;
    callback picked(string);
    fill: true;
    pad: 14px;
    HorizontalLayout {
        vertical-stretch: 0;
        SectionTitle { title: root.title; subtitle: root.subtitle; icon: root.icon; tone: root.tone; }
        VerticalLayout {
            alignment: center;
            Pill { text: root.rows.length; tone: root.tone; }
        }
    }
    if root.rows.length == 0: Hint { text: root.empty; }
    if root.rows.length == 0: Rectangle { vertical-stretch: 1; }
    if root.rows.length > 0: ListView {
        vertical-stretch: 1;
        min-height: 120px;
        for r in root.rows: Rectangle {
            height: 30px;
            border-radius: Theme.radius-s;
            background: rta.has-hover ? Theme.hover : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    text: r.name;
                    color: Theme.text;
                    font-size: Theme.fs-m;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Mono {
                    text: r.waiting ? "waiting" : r.value;
                    color: r.waiting ? Theme.text-3 : root.tone;
                    font-weight: 600;
                }
            }
            rta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(r.name); }
            }
        }
    }
}

export component VariablesPage inherits Rectangle {
    HorizontalLayout {
        padding: 26px;
        padding-top: 8px;
        spacing: 16px;
        sv := ScrollView {
            width: 410px;
            VerticalLayout {
                width: sv.visible-width;
                alignment: start;
                spacing: 14px;
                padding-right: 6px;
                if VarsState.pmdg.length > 0: Card {
                    SectionTitle {
                        title: "PMDG SDK";
                        subtitle: "Cockpit events and data of installed PMDG aircraft";
                        icon: Icons.plane;
                        tone: Theme.warning;
                    }
                    for r in VarsState.pmdg: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: r.label;
                                color: Theme.text;
                                font-size: Theme.fs-m;
                                font-weight: 600;
                            }
                            Text {
                                text: r.package;
                                color: Theme.text-3;
                                font-size: Theme.fs-xs;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Pill { text: r.status; tone: Theme.tone(r.tone); dot: true; }
                        }
                    }
                    if VarsState.pmdg-any-off: Hint { text: "PMDG events already work. Reading cockpit data (displays, conditions) needs EnableDataBroadcast=1 in the aircraft options file."; }
                    if VarsState.pmdg-any-off: HorizontalLayout {
                        Button {
                            text: "Enable data broadcast";
                            icon: Icons.zap;
                            kind: ButtonKind.accent;
                            clicked => { VarsState.enable-broadcast(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                Card {
                    HorizontalLayout {
                        SectionTitle {
                            title: "WASM LVAR bridge";
                            subtitle: VarsState.lvar-count + " LVARs discovered";
                            icon: Icons.braces;
                            tone: Theme.violet;
                        }
                        VerticalLayout {
                            alignment: center;
                            Pill {
                                text: VarsState.bridge-active ? "connected" : "offline";
                                tone: VarsState.bridge-active ? Theme.success : Theme.text-3;
                                dot: true;
                            }
                        }
                    }
                    Caption { text: "SET LVAR"; }
                    HorizontalLayout {
                        spacing: 8px;
                        Field { text <=> VarsState.lvar-name; mono: true; placeholder: "LVAR name"; }
                        Field {
                            width: 70px;
                            horizontal-stretch: 0;
                            text <=> VarsState.lvar-value;
                            mono: true;
                        }
                        Button {
                            text: "Set";
                            kind: ButtonKind.accent;
                            clicked => { VarsState.set-lvar(); }
                        }
                    }
                    Caption { text: "RUN RPN CODE"; }
                    HorizontalLayout {
                        spacing: 8px;
                        Field {
                            text <=> VarsState.rpn;
                            mono: true;
                            placeholder: "(>K:TOGGLE_MASTER_BATTERY)";
                            accepted => { VarsState.run-rpn(); }
                        }
                        Button {
                            text: "Run";
                            icon: Icons.play;
                            kind: ButtonKind.accent;
                            clicked => { VarsState.run-rpn(); }
                        }
                    }
                    HorizontalLayout {
                        Button {
                            text: "Rescan LVARs";
                            icon: Icons.refresh;
                            small: true;
                            kind: ButtonKind.ghost;
                            clicked => { VarsState.rescan-lvars(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                Card {
                    SectionTitle {
                        title: "SimVar";
                        subtitle: "Watch or write any simulation variable";
                        icon: Icons.eye;
                    }
                    Field {
                        text <=> VarsState.simvar-name;
                        mono: true;
                        placeholder: "e.g. NAV STANDBY FREQUENCY:1 or INDICATED ALTITUDE, meters";
                        accepted => { VarsState.watch-simvar(); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "Watch";
                            icon: Icons.eye;
                            kind: ButtonKind.accent;
                            clicked => { VarsState.watch-simvar(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Field {
                            width: 100px;
                            horizontal-stretch: 0;
                            text <=> VarsState.simvar-value;
                            mono: true;
                        }
                        Button {
                            text: "Set value";
                            kind: ButtonKind.secondary;
                            clicked => { VarsState.set-simvar(); }
                        }
                    }
                }
                Rectangle { height: 6px; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            Field {
                text <=> VarsState.filter;
                placeholder: "Filter SimVars and LVARs";
                icon: Icons.filter;
                clearable: true;
                edited => { VarsState.filter-changed(); }
            }
            ValueTable {
                vertical-stretch: 1;
                title: "SimVars";
                subtitle: "Used by the active profile, plus the ones you watch";
                icon: Icons.activity;
                tone: Theme.accent;
                rows: VarsState.simvars;
                empty: "SimVars used by the active profile appear here automatically. Add more with Watch.";
                picked(n) => { VarsState.pick-simvar(n); }
            }
            ValueTable {
                vertical-stretch: 1;
                title: "LVARs";
                subtitle: "Local variables published by the aircraft";
                icon: Icons.braces;
                tone: Theme.violet;
                rows: VarsState.lvars;
                empty: "LVARs appear once the SPAD.neXt WASM bridge is connected.";
                picked(n) => { VarsState.pick-lvar(n); }
            }
        }
    }
}
